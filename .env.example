# ─── ADMIN ──────────────────────────────────────────────────────────────────
# Token para acessar o painel admin. Use uma string longa e aleatória.
ADMIN_TOKEN=coloque_um_token_secreto_muito_longo_aqui

# Segredo para assinar o JWT de sessão do admin (mínimo 32 caracteres)
JWT_SECRET=coloque_outro_segredo_muito_longo_aqui

# ─── BANCO DE DADOS (PostgreSQL) ────────────────────────────────────────────
DATABASE_URL=postgresql://usuario:senha@localhost:5432/grupovip

# ─── SYNCPAY ────────────────────────────────────────────────────────────────
# NÃO usar prefixo NEXT_PUBLIC_ — essas variáveis são exclusivamente server-side
SYNCPAY_CLIENT_ID=seu_client_id_aqui
SYNCPAY_CLIENT_SECRET=seu_client_secret_aqui
SYNCPAY_BASE_URL=https://api.syncpay.com.br

# ─── TELEGRAM BOT ───────────────────────────────────────────────────────────
# Token obtido no @BotFather do Telegram
# NÃO usar prefixo NEXT_PUBLIC_ — server-side only
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ

# ─── APP ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
